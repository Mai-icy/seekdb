obm=OBI(cluster=1:1:1,proxy_num=1,ct_num=1,locality=SZ:SZ:SZ,version=master);
obm.proxy0.set extra_config=enable_strict_kernel_release=false,work_thread_num=128,automatic_match_work_thread=false,enable_prometheus=false;
obm.reboot;
alter system set datafile_size='270g';
alter resource unit sys_unit_config min_cpu=1,max_cpu=1;
alter system set system_memory='6g';
alter system set syslog_io_bandwidth_limit='3000m';
alter system set weak_read_version_refresh_interval='1s';
alter system set ignore_replay_checksum_error=True;
alter proxyconfig set server_detect_fail_threshold=300;
alter proxyconfig set client_max_connections=65535;
alter proxyconfig set proxy_mem_limited='100G';
alter proxyconfig set enable_ob_protocol_v2=True;
alter proxyconfig set enable_reroute=True;
alter proxyconfig set enable_index_route=True;
alter system set ob_enable_batched_multi_statement=true tenant=all;
alter system set _enable_partition_level_retry=false;
alter system set _rowsets_enabled=false tenant = all;
alter system set _pushdown_storage_level = 3 tenant=all;
alter system set schema_history_recycle_interval='10s';
alter system set schema_history_expire_time='2h';
alter system set _enable_easy_keepalive=true;
alter system set _rowsets_enabled = 1 tenant=all;
alter system set _rowsets_max_rows = 256 tenant=all;
alter system set recyclebin_object_expire_time='4h';
alter system set _recyclebin_object_purge_frequency='10m';
alter system set_tp tp_no = 367, error_code = 20, frequency = 1;
alter system set major_compact_trigger = 3 tenant = all;
alter system set _enable_defensive_check=2;
alter system set enable_async_syslog=False;
create table tenant_status(name varchar(100) primary key,locality varchar(100));
insert into tenant_status(name,locality) values('mysql_tenant','1F');
